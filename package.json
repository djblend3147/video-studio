    "@remotion/captions": "^4.0.538",
    "@remotion/cli": "^4.0.538",
    "@remotion/install-whisper-cpp": "^4.0.538",
    "@remotion/media-parser": "^4.0.538",
    "@remotion/media-utils": "^4.0.538",
    "@remotion/paths": "^4.0.538",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "^4.0.538"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
